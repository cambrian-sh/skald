{
  "name": "@cambrian/skald",
  "version": "0.1.0",
  "description": "Project context and memory setup for coding agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/cambrian-sh/skald.git"
  },
  "license": "MIT",
  "keywords": [
    "coding-agent",
    "project-context",
    "project-memory",
    "mcp",
    "codebase-memory"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "skald": "./src/cli.ts"
  },
  "files": [
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "product.md",
    "RELEASING.md",
    "SECURITY.md",
    "src",
    "vendor/engine"
  ],
  "scripts": {
    "build": "bun run native:build && bun run scripts/build.ts",
    "benchmark": "bun test --isolate test/context-quality.test.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "dev": "bun run native:build && bun run src/cli.ts",
    "prepublishOnly": "bun run check && bun run build && bun run scripts/release-publish-guard.ts",
    "package:release": "bun run scripts/package-release.ts",
    "package:release:root": "bun run scripts/package-release-root.ts",
    "stage:engine": "bun run scripts/stage-engine.ts",
    "test": "bun run native:build && bun test --isolate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "extract:engine-source": "bun run scripts/extract-afsin-source.ts",
    "native:build": "bun run scripts/build-native.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "bun-types": "^1.4.2",
    "node-api-headers": "1.9.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
