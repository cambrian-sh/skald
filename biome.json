{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "useImportType": "error",
        "noParameterAssign": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "**",
      "!design",
      "!.omo",
      "!.skald",
      "!.codebase-memory",
      "!.mcp.json",
      "!opencode.json",
      "!opencode.jsonc",
      "!.claude",
      "!.codex"
    ],
    "maxSize": 5000000,
    "ignoreUnknown": true
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
